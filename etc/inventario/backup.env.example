# /etc/inventario/backup.env
#
# Fichero de credenciales para el backup de la base de datos.
# En el servidor real, este fichero vive en /etc/inventario/backup.env
# con permisos 0600 y dueño root:root (solo root lo lee).
# El valor real NO se versiona; en el repo solo está el .example.
#
# Instalar:
#   sudo install -d -m 0750 -o root -g root /etc/inventario
#   sudo install -m 0640 -o root -g root ./backup.env.example /etc/inventario/backup.env
#   sudoedit /etc/inventario/backup.env   # rellenar valores reales
#
# El script backup-db.sh hace set -a; source ...; set +a, así que
# cualquier variable definida aquí se exporta al entorno.

# Dónde se escriben los backups
BACKUP_DIR=/var/backups/inventario

# Dónde se escribe el log
LOG_DIR=/var/log/inventario

# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventario
DB_USER=inventario
DB_PASSWORD=CAMBIAME_POR_UNA_CONTRASEÑA_SEGURA

# Retención: borrar backups con mtime > RETENTION_DAYS días
RETENTION_DAYS=7
