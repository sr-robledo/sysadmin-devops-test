# .env.example para docker-compose
#
# Copiar como .env y editar los valores reales:
#   cp .env.example .env
#   sudo chown root:root .env
#   sudo chmod 0600 .env
#
# El .env real NO se versiona (.gitignore).

# ─── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_DB=inventario
POSTGRES_USER=inventario
# Generar con: openssl rand -base64 24
POSTGRES_PASSWORD=CAMBIAME_POR_CONTRASEÑA_SEGURA
